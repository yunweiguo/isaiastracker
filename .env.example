# Production canonical origin. Use http://localhost:3000 for a non-indexable preview.
NEXT_PUBLIC_SITE_URL=https://isaiastracker.site
NEXT_PUBLIC_SITE_NAME=Stormscope
NHC_USER_AGENT=Stormscope/1.0 (+https://isaiastracker.site)
# Persistent writable directory for a single Node deployment. Mount a volume in production.
DATA_DIR=.data
# Optional featured storm; blank selects an active Atlantic storm first.
FEATURED_STORM_ID=al092026
# Statistics are enabled only on the configured production origin.
NEXT_PUBLIC_GA_ID=G-BRMKDGR0S1
# Copy the site-specific script URL from Plausible Site installation.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.dialedgg.run/js/pa-ajXplDfPnOyZ3xMJQUObH.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=isaiastracker.site
# Replace the default OSM tile service with a production-appropriate provider if needed.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Generate locally: openssl rand -hex 32. Protects the refresh/IndexNow endpoint.
CRON_SECRET=
# Generate locally: openssl rand -hex 16. Served at /<key>.txt.
INDEXNOW_KEY=
# Keep disabled until the production host and key file are publicly reachable.
INDEXNOW_ENABLED=false
