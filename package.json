{
  "name": "stormscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy": "pnpm build:cf && opennextjs-cloudflare deploy",
    "refresh": "tsx --env-file-if-exists=.env.local scripts/refresh.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shpjs": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shpjs": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
