{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isaias-tracker",
  "account_id": "53494d83a36a3cbaa6f307787b2675ee",
  "main": "worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "isaias-tracker" },
  ],
  "r2_buckets": [
    { "binding": "WEATHER_DATA", "bucket_name": "isaias-tracker-weather" },
  ],
  "routes": [{ "pattern": "isaiastracker.site", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // NEXT_PUBLIC_MAP_TILE_URL / NEXT_PUBLIC_MAP_ATTRIBUTION must be supplied to
  // the build environment; runtime vars cannot replace compiled client settings.
  "vars": {
    "WEATHER_STORAGE": "r2",
    "NEXT_PUBLIC_SITE_URL": "https://isaiastracker.site",
    "NEXT_PUBLIC_SITE_NAME": "Stormscope",
    "NEXT_PUBLIC_PLAUSIBLE_DOMAIN": "isaiastracker.site",
    "NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL": "https://plausible.dialedgg.run/js/pa-ajXplDfPnOyZ3xMJQUObH.js",
    "NEXT_PUBLIC_GA_ID": "G-BRMKDGR0S1",
    "FEATURED_STORM_ID": "al092026",
    "NHC_USER_AGENT": "Stormscope/1.0 (+https://isaiastracker.site)",
    "INDEXNOW_ENABLED": "true",
  },
}
